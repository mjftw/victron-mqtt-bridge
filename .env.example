# ──────────────────────────────────────────────
# Victron Cerbo GX (source broker)
# ──────────────────────────────────────────────

# IP or hostname of the Cerbo GX on your local network
VICTRON_MQTT_HOST=192.168.1.100

# Set to true to connect on port 8883 with SSL instead of plain 1883
VICTRON_MQTT_USE_SSL=false

# How often (in seconds) the keepalive signal is sent to the Cerbo GX.
# Without it the broker stops streaming data after ~60 s.
KEEPALIVE_INTERVAL_SECONDS=60

# ──────────────────────────────────────────────
# Topic mapping
# ──────────────────────────────────────────────

# JSON object: Victron relative path (the segment after N/<serial>/) → full
# downstream topic to publish to.
#
# To discover available paths on your device, send a keepalive then subscribe:
#   mosquitto_pub  -h $VICTRON_MQTT_HOST -t "R/<serial>/keepalive" -m ""
#   mosquitto_sub  -h $VICTRON_MQTT_HOST -t "N/#" -v
TOPIC_MAPPING={"system/0/Dc/Battery/Soc": "victron/battery/soc", "system/0/Ac/Grid/L1/Power": "victron/grid/l1/power"}

# ──────────────────────────────────────────────
# Downstream broker (destination)
# ──────────────────────────────────────────────

# IP or hostname of the broker to publish bridged messages to
DOWNSTREAM_MQTT_HOST=192.168.1.200

# Port of the downstream broker
DOWNSTREAM_MQTT_PORT=1883

# Set to true to connect to the downstream broker over SSL
DOWNSTREAM_MQTT_USE_SSL=false

# Credentials for the downstream broker (leave commented out if not required)
# DOWNSTREAM_MQTT_USERNAME=
# DOWNSTREAM_MQTT_PASSWORD=
